<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pose_cmd</name>
  <version>0.1.0</version>
  <description>Publishes the commanded sonar/vehicle pose on /sim/cmd/rov1/pose: a held pose, a replay of the configured trajectory, or keyboard teleop.</description>
  <maintainer email="fabio.carapellese@seamorphrobotics.com">underwater_ws</maintainer>
  <license>Proprietary</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
