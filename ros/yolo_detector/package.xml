<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yolo_detector</name>
  <version>0.1.0</version>
  <description>YOLO (Ultralytics) on the ROV camera: the pool's H.264 stream, the real BlueROV2's BlueOS stream or an image topic in; vision_msgs/Detection2DArray and an annotated overlay out under /rov1/perception/camera.</description>
  <maintainer email="fabio.carapellese@seamorphrobotics.com">underwater_ws</maintainer>
  <license>Proprietary</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <!-- Ultralytics, torch and OpenCV are not rosdep keys: a venv from requirements.txt (run.sh, UW_YOLO_PYTHON) -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
