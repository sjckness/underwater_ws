<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rov_bringup</name>
  <version>0.1.0</version>
  <description>The real BlueROV2's ROS 2 side, inside the BlueOS ROS 2 extension: MAVROS to ArduSub (read-only plugin set) and rosbag2 recording profiles.</description>
  <maintainer email="fabio.carapellese@seamorphrobotics.com">underwater_ws</maintainer>
  <license>Proprietary</license>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_extras</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
