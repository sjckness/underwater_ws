# What BlueOS's Water Linked DVL extension sees as "the vehicle" (docker/pool/compose.yaml, service dvl-gateway).
# On a real BlueROV2 the extension reaches BlueOS's nginx as host.docker.internal; here this server stands in, so
# that the extension runs unmodified next to a BlueOS without a docker socket (no extensions of its own):
#   /mavlink2rest/            -> BlueOS's mavlink2rest (the extension's VISION_POSITION_DELTA, PARAM_SET, ...)
#   /cable-guy/v1.0/ethernet  -> a fixed answer: cable_guy is off in this BlueOS (it would manage the host's
#                                network), and the extension waits for it before anything else
#   everything else           -> the extension's own page, so that http://<this server>/ shows it with its live
#                                attitude and status, as BlueOS shows it on a vehicle
# nginx's template step fills in the ${...} from the service's environment; nginx's own $variables stay.
server {
    listen 80;

    location = /cable-guy/v1.0/ethernet {
        default_type application/json;
        return 200 '[{"name": "eth0", "addresses": [{"ip": "${DVL_EXTENSION_IP}", "mode": "server"}]}]';
    }

    location /mavlink2rest/ {
        proxy_pass http://${BLUEOS_HOST};
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://${DVL_EXTENSION_HOST};
        proxy_set_header Host $host;
    }
}
